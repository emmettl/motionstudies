{
  "allchange": {
    "required": [
      "data/all-change-rail-led-morning.json",
      "data/all-change-day-manifest.json"
    ],
    "data_pattern": "data/all-change[^/]*(?:/.*)?"
  },
  "correspondances": {
    "required": [
      "data/correspondances-morning.json",
      "data/correspondances-day-manifest.json"
    ],
    "data_pattern": "data/correspondances[^/]*(?:/.*)?"
  },
  "umlauf": {
    "required": [
      "data/berlin-morning.json",
      "data/ring-layout.json"
    ],
    "data_pattern": "data/(?:berlin-morning|berlin-water|ostkreuz-bridge|ostkreuz|lineage|ring-layout)\\.json"
  },
  "norikae": {
    "required": [
      "data/synthetic-preview.json"
    ],
    "data_pattern": "data/synthetic-preview\\.json"
  },
  "manifest": {
    "required": [
      "data/demo-study.json",
      "data/ports.json"
    ],
    "data_pattern": "data/(?:demo/[^/]+-[0-9a-f]{12}\\.json|demo-study\\.json|ports\\.json|port-statistics\\.json|land\\.geojson)"
  },
  "grid84": {
    "required": [
      "data/hyde/index.json",
      "data/hyde/popc_1961.json",
      "data/hyde/popc_1961.bin.gz"
    ],
    "data_pattern": "data/hyde/(?:index\\.json|popc_[0-9]{4}\\.(?:json|bin\\.gz))"
  }
}
