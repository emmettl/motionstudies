{
  "name": "zenit-hosting",
  "account_id": "8cac82a07417990e553f88793670f361",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "motionstudies.app/zenit*", "zone_name": "motionstudies.app" },
    { "pattern": "zenit.motionstudies.app", "custom_domain": true }
  ],
  "assets": {
    "directory": ".hosting-assets",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "main": "hosting/zenit-subdomain.mjs"
}
