{
  "name": "motionstudies",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Motion Studies catalogue, shared packages and widget lab",
  "workspaces": [
    "packages/*",
    "lab"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "lab": "vite --config lab/vite.config.mjs --host 127.0.0.1 --port 4174",
    "build:lab": "tsc -p lab && vite build --config lab/vite.config.mjs",
    "build:packages": "node scripts/build-packages.mjs",
    "check:packed": "node scripts/check-packed-packages.mjs",
    "check:packages": "tsc -p packages/core && tsc -p packages/three && tsc -p packages/web && tsc -p packages/data",
    "check:tests": "tsc -p packages/core/tsconfig.test.json && tsc -p packages/three/tsconfig.test.json && tsc -p packages/web/tsconfig.test.json && tsc -p services/airports/tsconfig.test.json && tsc -p services/feed-observer/tsconfig.test.json",
    "check:architecture": "node scripts/check-edition-boundaries.mjs",
    "typecheck": "npm run check:packages && npm run check:tests && tsc -p lab && tsc -p tsconfig.tests.json && npm run check:airports && npm run check:feed-observer",
    "lint": "oxlint",
    "test": "vitest run && node --test hosting/*-subdomain.test.mjs",
    "test:lab": "playwright test --config playwright.lab.config.ts",
    "test:loaders": "playwright test --config playwright.loaders.config.ts",
    "profile:idle-decode": "node scripts/profile-idle-decode.mjs",
    "profile:first-view": "node scripts/profile-first-view.mjs",
    "fonts:vendor": "node scripts/vendor-web-fonts.mjs",
    "build": "npm run build:lab && node scripts/build-site.mjs",
    "build:release": "node scripts/build-packages.mjs --release",
    "check:release": "node scripts/check-packed-packages.mjs --release",
    "release:dry-run": "node scripts/publish-packages.mjs",
    "check:airports": "tsc -p services/airports",
    "dev:airports": "wrangler dev --config wrangler.airports.jsonc --port 8787",
    "feeds:health": "node scripts/feed-health.mjs",
    "feeds:evidence-plan": "node scripts/feed-evidence-plan.mjs",
    "feeds:observe": "node scripts/observe-feeds.mjs",
    "check:feed-observer": "tsc -p services/feed-observer",
    "feeds:push": "node scripts/push-feed-health.mjs",
    "check:terrain-consumers": "node scripts/check-terrain-consumers.mjs",
    "check:weather-consumers": "node scripts/check-weather-consumers.mjs",
    "check:power-consumers": "node scripts/check-power-consumers.mjs"
  },
  "dependencies": {
    "@motionstudies/core": "0.1.0-alpha.46",
    "@motionstudies/three": "0.1.0-alpha.46",
    "@motionstudies/web": "0.1.0-alpha.46",
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/parser": "7.29.9",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxc-transform-react": "0.152.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "npm@11.21.1"
}
