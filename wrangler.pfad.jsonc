{
  "name": "pfad-hosting",
  "account_id": "8cac82a07417990e553f88793670f361",
  "compatibility_date": "2026-09-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "motionstudies.app/pfad*",
      "zone_name": "motionstudies.app"
    },
    {
      "pattern": "pfad.motionstudies.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".hosting-assets",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "main": "hosting/pfad-subdomain.mjs"
}
